{
  "name": "jeju-realestate-mvp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch --env-file-if-exists=.env --import tsx server/dev-server.ts",
    "build": "tsc --noEmit && npm run check:env-exposure && vite build",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "check:env-exposure": "tsx scripts/check-env-exposure.ts",
    "import:reference": "node --env-file-if-exists=.env --import tsx scripts/import-reference.ts",
    "collect": "NODE_USE_ENV_PROXY=1 node --env-file-if-exists=.env --import tsx scripts/collect-transactions.ts",
    "match": "node --env-file-if-exists=.env --import tsx scripts/match-transactions.ts",
    "test:e2e": "node --env-file-if-exists=.env tests/e2e/map.e2e.mjs",
    "check:secrets": "node --env-file-if-exists=.env --import tsx scripts/check-secrets.ts"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/shapefile": "^0.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "proj4": "^2.22.0",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
