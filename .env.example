# Copy to .env for local development. Never commit .env.
# Server-only values. Do NOT prefix these with VITE_ (Vite exposes VITE_* to the browser bundle).

# PostgreSQL connection string (local or Supabase).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/jeju_dev
# "require" for hosted Postgres (Supabase), "disable" for local.
DATABASE_SSL=disable

# Integration tests run against this database (it is wiped by the tests).
TEST_DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/jeju_test

# data.go.kr service key (Decoding key). Only the collector batch reads it.
DATA_GO_KR_SERVICE_KEY=

# Local API dev server port (vite proxies /api to it).
API_PORT=3001

# Browser-exposed value (public identifier, restrict by domain in Kakao console). Used from TASK-006.
VITE_KAKAO_MAP_JS_KEY=
